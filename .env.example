# ── VOIDAJ — server environment ──────────────────────────────
# Copy this file to ".env" and fill in values.

# REQUIRED. Postgres connection string. The server will not start without it.
#
#   Local development, using the Postgres you run yourself:
#     DATABASE_URL=postgres://postgres@127.0.0.1:5432/voidaj
#
#   Production: create a free database at https://neon.tech and paste the
#   connection string it gives you. Set the same value in the Vercel
#   dashboard under Settings → Environment Variables.
DATABASE_URL=

# Secret used to sign login sessions. Set a long random string in production
# (Vercel: Settings → Environment Variables). Defaults to a dev value if unset,
# which is fine locally and NOT fine in production.
# JWT_SECRET=

# Enable the real LLM companion. Get a key at https://console.anthropic.com
# Without it the companion falls back to the rule-based engine and still works.
ANTHROPIC_API_KEY=

# Optional: which Claude model the companion uses (default: claude-sonnet-5)
# COMPANION_MODEL=claude-sonnet-5

# Optional: port for the API server locally (default: 8787). The web app
# proxies /api to this port (see vite.config.js). Unused on Vercel.
# API_PORT=8787

# Optional escape hatch: set to 1 only if your Postgres host's TLS certificate
# can't be verified by Node. Keeps traffic encrypted but stops checking who is
# on the other end.
# PGSSL_NO_VERIFY=1

# Cover photos for communities and events (Supabase Storage). In the
# Supabase dashboard: Storage → New bucket → name it "covers" and tick
# "Public bucket". Then Project Settings → API: copy the Project URL and the
# service_role key here, and into Vercel's Environment Variables. The
# service key is a secret — never put it in frontend code.
# Without these, uploads still work locally (photos are kept inline in the
# database) but are switched off on Vercel.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=covers

# Sign in with Google and Apple. Each button switches on once its keys are
# set here and in Vercel. Without them the buttons say "Not set up yet".
# PUBLIC_URL is the site's address, used to build the callback links
# (e.g. https://voidaj.com). Locally it can stay unset.
# PUBLIC_URL=https://voidaj.com
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID (Web application). Authorised redirect URIs:
#   https://voidaj.com/api/auth/google/callback
#   http://localhost:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Apple (needs a paid Apple Developer account): developer.apple.com →
# Identifiers → a Services ID with "Sign in with Apple", return URL
#   https://voidaj.com/api/auth/apple/callback
# (Apple only allows https, so it can't be tried on plain localhost).
# Then Keys → a key with Sign in with Apple; download the .p8 file.
# APPLE_CLIENT_ID=com.voidaj.web          # the Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Email confirmation codes (server/guard.js). New accounts get a 6-digit
# code by email; until it's typed in they can't post jobs, create events or
# communities, or start conversations. Codes are sent with Resend
# (resend.com → API Keys; verify voidaj.com under Domains first). Without a
# key the code is printed in the server log and nothing is held back.
# RESEND_API_KEY=
# EMAIL_FROM=VOIDAJ <hello@voidaj.com>
# Set to 1 to hold unconfirmed accounts back even without email sending.
# REQUIRE_EMAIL_CONFIRM=1

# Attempt limits on sign-in, sign-up and posting are on by default. Only
# the test suite turns them off.
# RATE_LIMITS=off

# Who can open /admin (every account's name and email, ID checks, disputes).
# Comma-separated. An address only counts once it's proven: a confirmed
# email code, or a Google/Apple sign-in with that address.
# ADMIN_EMAILS=you@example.com

# Where advert requests are emailed (Admin → Ads is where they're reviewed).
# Defaults to hello@voidaj.com.
# ADS_NOTIFY_EMAIL=hello@voidaj.com

# Quick Job payments through Paystack (server/payments.js). VOIDAJ takes no
# cut and never holds the money: the poster's saved card is charged when the
# job is done, split straight to the worker's Paystack subaccount, with the
# card fee added on top for the poster. Without a key, payment stays
# arranged between the two people, as before. Use the sk_test_ key locally
# and on previews; the sk_live_ key only in Vercel Production.
# PAYSTACK_SECRET_KEY=
# Currencies the Paystack account takes (default NGN).
# PAYSTACK_CURRENCIES=NGN
# Override the card fee if Paystack's pricing for this account differs from
# 1.5% + ₦100 (₦100 waived under ₦2,500), capped at ₦2,000. Flat and cap
# are in kobo.
# PAYSTACK_FEE_PERCENT=1.5
# PAYSTACK_FEE_FLAT=10000
# PAYSTACK_FEE_CAP=200000
# Sent with the cron call to /api/cron/payments: hourly from GitHub Actions
# (.github/workflows/payments-cron.yml, which needs the same value as an
# Actions secret named CRON_SECRET and the PAYMENTS_CRON_URL variable), and
# daily from Vercel as a backup. It charges jobs a worker marked done that
# the poster didn't confirm in 48 hours, reminds posters before that, and
# retries failed cards.
# CRON_SECRET=
# Limits while either side of a paid job is new (fewer than 3 paid jobs)
# and they aren't both ID verified, in kobo: per job (default ₦50,000) and
# per poster per week (default ₦150,000). server/job-safety.js
# PAY_NEW_JOB_CAP=5000000
# PAY_NEW_WEEK_CAP=15000000
# Key for the hash that spots one bank account on two VOIDAJ accounts. Set
# it once and never change it (defaults to JWT_SECRET).
# PAYOUT_HASH_KEY=
# Where chargebacks and job problem reports are emailed (defaults to
# ADS_NOTIFY_EMAIL, then hello@voidaj.com).
# TEAM_NOTIFY_EMAIL=
